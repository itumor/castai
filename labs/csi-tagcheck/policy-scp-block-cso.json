{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyCSOTagging",
      "Effect": "Deny",
      "Action": ["ec2:CreateTags", "ec2:DeleteTags"],
      "Resource": "*",
      "Condition": {
        "ForAnyValue:StringLike": {
          "aws:TagKeys": ["CSO*", "cso*", "Cso*"]
        }
      }
    }
  ]
}
