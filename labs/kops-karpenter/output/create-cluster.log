       kops validate cluster --name "${KOPS_CLUSTER_NAME}" --wait 10m
  4. Tear down when finished:
       kops delete cluster --name "${KOPS_CLUSTER_NAME}" --yes
       aws s3 rb "${KOPS_STATE_STORE}" --force
       aws s3 rb "${KOPS_DISCOVERY_STORE}" --force

