# Terraform working directory and local state
.terraform/
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info

# Local configuration and secrets
terraform.tfvars
*.auto.tfvars
!terraform.tfvars.example
backend.hcl
backend.*.hcl
!backend.hcl.example

# Plans, crash logs, and local overrides
*.tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Support email exports contain API tokens; keep local only.
# Track only the README so the directory purpose is documented.
ec2createtags_emails/*
!ec2createtags_emails/README.md

# Assistant memory and logs
.remember/

# Python bytecode
__pycache__/
*.py[cod]

# Generic secrets / credentials
*.pem
*.key
*_key
id_*
*.env
.env.*
!*.env.example
!*.env-example
!.env.example
awskey.env
.aws/credentials
kubeconfig*
*.p12
*.pfx
*.keystore
*.jks
secrets/
!secrets/.gitkeep

