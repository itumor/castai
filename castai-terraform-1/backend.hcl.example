bucket       = "my-terraform-state-bucket"
key          = "castai/my-eks-cluster/terraform.tfstate"
region       = "eu-central-1"
encrypt      = true
use_lockfile = true

# Optional: use a customer-managed KMS key instead of the bucket default.
# kms_key_id = "arn:aws:kms:eu-central-1:123456789012:key/00000000-0000-0000-0000-000000000000"

