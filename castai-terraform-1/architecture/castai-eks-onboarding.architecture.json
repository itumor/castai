  "cards": [
    {
      "dot": "cyan",
      "title": "One-Apply Flow",
      "items": [
        "Preflight preconditions fail fast on auth mode, subnets, and security groups",
        "IAM role and instance profile are created before onboarding starts",
        "The Helm provider authenticates with aws eks get-token"
      ]
    },
    {
      "dot": "emerald",
      "title": "Default Autoscaling Policy",
      "items": [
        "Spot-first node template with on-demand fallbacks enabled",
        "Evictor removes eligible nodes on a 60s cycle with a 10-minute grace period",
        "Empty nodes are removed after a 300s delay; CPU stays within min/max core limits"
      ]
    },
    {
      "dot": "amber",
      "title": "Safe Teardown",
      "items": [
        "delete_nodes_on_disconnect defaults to false so destroy keeps EC2 nodes",
        "API token enters only through TF_VAR_castai_api_token",
        "State, plans, tfvars, and backend config stay out of version control"
      ]
    }
