# CAST AI Dashboard configuration
# Copy this file to .env and fill in real values.

# CAST AI API key (required).
# Generate from the CAST AI console under Settings -> API tokens.
CASTAI_API_KEY=

# CAST AI regional endpoint (default: api.cast.ai).
# Override for regional clusters (e.g. api.eu.cast.ai, api.india.cast.ai).
CASTAI_REGION=api.cast.ai

# Optional CAST AI organization id. Required only when CASTAI_API_KEY is an
# enterprise master key: it is sent as the X-CastAI-Organization-Id header.
# Without it, such keys silently see empty cluster lists.
CASTAI_ORG_ID=

# Port for the dashboard HTTP server (default: 3000).
PORT=3000

# Optional bearer token that protects the dashboard HTTP endpoints.
# When set, callers must send `Authorization: Bearer <token>`.
# Leave blank to disable auth (development only).
DASHBOARD_API_TOKEN=

# Cache time-to-live in milliseconds for upstream CAST AI API responses (default: 60000).
# Lower values make the dashboard fresher but increase API usage; higher values reduce API calls.
DASHBOARD_CACHE_TTL_MS=60000
