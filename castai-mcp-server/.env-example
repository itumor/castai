# CAST AI MCP server — example environment file.
# Copy to .env and fill in real values. .env is gitignored; never
# commit secrets. Placeholders only here.

# Required: read-only CAST AI API key.
# Create at https://console.cast.ai/settings/api-keys with only
# read scopes (see .kimchi/docs/castai-mcp-security.md §2).
CASTAI_API_KEY=your_readonly_api_key_here

# Optional: CAST AI API base. Defaults to the EU region.
CASTAI_API_BASE=https://api.eu.cast.ai

# Optional: bound organization UUID. When set, the server only operates
# against this org and rejects cross-org requests.
CASTAI_ORG_ID=optional_org_id

# Optional: log verbosity. One of: debug, info, warn, error. Default: info.
LOG_LEVEL=info

# Optional: write approval mode.
#   block   - refuse any non-GET upstream call (default, safest).
#   approve - require an approval token for write calls (not yet wired in step 1).
APPROVAL_MODE=block
