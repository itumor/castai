# CAST AI Enterprise Dashboard — local configuration example.
# Copy to .env and fill in. NEVER commit the filled-in file (.env is git-ignored).
# Placeholders only — this file must never contain real values.
#
# Local alternative: .streamlit/secrets.toml with keys
#   [castai] api_key / base_url / enterprise_id
# (also git-ignored; local development only). Environment variables win when both
# are set — do not use both sources for the same key in one deployment.

# REQUIRED. CAST AI Enterprise API key (read-only).
# Provision ONLY these read scopes (docs/security-requirements.md SEC-3):
#   organizations:read
#   kubernetes/external-clusters:read
#   cost-reports:read
#   inventory:read
#   workload-autoscaling:read
#   recommendations:read
#   notifications:read            # only if CASTAI_ENABLE_NOTIFICATIONS=true
# NEVER use a key carrying *:write / *:admin, billing, or cluster-connect scopes.
CASTAI_API_KEY=

# Base URL — pick ONE regional endpoint (https only; validated against an allow-list,
# anything else is rejected to prevent key exfiltration):
#   EU (default): https://api.eu.cast.ai
#   US:           https://api.cast.ai
#   India:        https://api.in.cast.ai
CASTAI_BASE_URL=https://api.eu.cast.ai

# OPTIONAL. Enterprise root org ID override. When set, that org is used as the
# hierarchy root (fails fast if not visible to the key or not type ENTERPRISE).
# Leave empty for auto-detection via the unique-ENTERPRISE heuristic
# (docs/enterprise-hierarchy.md §4).
CASTAI_ENTERPRISE_ID=

# Tier-1 per-org fan-out concurrency (accepted range 4-16, hard cap 32; default 8).
CASTAI_MAX_WORKERS=8

# Feature flags — optional Tier-1 add-ons (architecture.md §3, ADR v2):
CASTAI_ENABLE_NOTIFICATIONS=false     # v2: +3 exact-count reads/org (page.limit=1: unacked / critical+error / warning). Loader is wired & cached but consumed only in drill-down/pills paths, no v2 KPI card yet (app.py). ("+1 call/org page 1" — superseded 2026-09-21, see ADR v2)
CASTAI_ENABLE_ORG_EFFICIENCY=true     # v2: 6th Tier-1 call/org (default ON, ADR v2 R2) — GET organization/clusters/efficiency -> per-cluster waste_*_usd columns (USD/window; never summed with spend or savings). Set false to return to the 1+5xN v1 sweep. The org-level efficiency/summary totalWaste cross-check stays drill-down-only. ("efficiency/summary org-waste cross-check" — superseded 2026-09-21, see ADR v2)
CASTAI_ENABLE_REBALANCE_SCHEDULES=true # v2-OPS: 7th Tier-1 call/org (default ON, ADR v2 R11) — GET /v1/rebalancing-schedules -> org-level schedule inventory on FleetResult.rebalance_schedules (schedule<->cluster linkage is NOT row-resolvable: fleet rebalance_* cells stay NA, per-cluster truth is the drill-down rebalancing-jobs call). Set false to keep the 1+6xN sweep.
CASTAI_ENABLE_ACTIVE_PROBE=false      # +1 whitelisted read-POST: cost-reports/clusters/active coverage oracle

# --- ADR v2 additions (2026-09-21) -------------------------------------------
# Name exactly as consumed in app.py (_settings_flag env fallback);
# config/settings.py carries no native field for this flag.
# +1 call/org: org OOMKilled totals via cost-reports/organization/
# workload-event-metrics -> fleet "OOM kills (window)" KPI card. Org totals
# only (the org response carries no clusterId); per-cluster OOM stays Tier-2.
CASTAI_ENABLE_CLUSTER_HISTORY=false

# v2 knobs that are NOT env-exposed (by design — code constants, ADR v2 R3/R10):
#   enrichment batch caps (realized 100, na_policies/wa_coverage/health 400;
#     <=800 estimated calls/run) & 15-min session cache — services/enrichment_service.py
#   CSV export cap 500 rows — ui/tables.py EXPORT_ROW_CAP
#   cache TTLs (notifications 5 min; batches/OOM 15 min; histories 6 h) — app.py
